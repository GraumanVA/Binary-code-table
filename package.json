{
  "name": "binary-code-bounds-atlas",
  "private": true,
  "version": "0.3.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "python -m atlas build",
    "check": "python -m atlas check",
    "serve": "python -m atlas serve",
    "package": "python -m atlas package",
